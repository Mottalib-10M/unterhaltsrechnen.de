---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/unterhaltsrechner/?lang=en" title="German child support calculator 2026" width="100%" height="1250" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
const code2 = `<iframe src="${SITE_URL}/embed/pfaendungsrechner/?lang=en" title="German garnishment calculator 2026" width="100%" height="1000" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the German child support or garnishment calculator" description="Embed the 2026 Düsseldorf Table child support calculator or the garnishment calculator on your site for free in an iframe: copy the code, no sign-up, no cookies." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed a calculator</h1>
    <p class="mt-3 text-lg text-navy-700">One code to copy, no sign-up and no cost. Expat groups, advice centres and newsrooms add it in a minute.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <h2>Child support under the Düsseldorf Table</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <h2>Garnishment calculator from 1 July 2026</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code2}</code></pre>
    <p>Terms: keep the link below the calculator visible, do not modify the calculator, no warranty. New tables are loaded here, so your embed stays current. Remove <code>?lang=en</code> for the German version.</p>
    <p>Incomes and children’s ages typed into the embedded calculator stay on the reader’s device; the frame stores nothing and loads no tracking. Anything unclear? Use the <a href={route('contact', lang)}>contact page</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/unterhaltsrechner/?lang=en" title="German child support calculator 2026" width="100%" height="1250" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
